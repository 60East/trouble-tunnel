#!/bin/bash
HERE=`dirname $0`
JAR=`find $HERE -type f -name trouble-tunnel-*.jar`
if [ -e "$JAR" ]; then
    java -jar $JAR $*
    exit 0
fi

JAR=`find ./dist -type f -name trouble-tunnel-*.jar`

if [ -e "$JAR" ]; then
    java -jar $JAR $*
    exit 0
else
    echo "could not find trouble tunnel JAR" 1>&2
    exit 1
fi
